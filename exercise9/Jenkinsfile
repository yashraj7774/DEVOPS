
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('exercise9') {
                    echo 'Installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('exercise9') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('exercise9') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "${WORKSPACE}/python-app-deploy"
                        cp app.py requirements.txt test_app.py \
                            "${WORKSPACE}/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application...'
                sh '''
                    cd "${WORKSPACE}/python-app-deploy"
                    PYTHONPATH="${WORKSPACE}/python-app-deploy" \
                        "${WORKSPACE}/exercise9/.venv/bin/python" \
                        -m unittest test_app
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
